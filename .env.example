# Application
APP_NAME=data-quality-platform
APP_ENV=development
LOG_LEVEL=INFO

# Databricks CLI profile name (not a token or password)
DATABRICKS_CONFIG_PROFILE=hamsaavarshinib11@gmail.com
DATABRICKS_CATALOG=olist_data_quality
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=gold

# AWS/S3. Set AWS_REGION to the actual region of your bucket.
AWS_REGION=REPLACE_WITH_YOUR_BUCKET_REGION
S3_BUCKET=olist-data-quality-s3
S3_RAW_PREFIX=raw/olist/initial/
S3_MANIFEST_PREFIX=metadata/ingestion-manifests/

# Data quality rules: true enables the corresponding rule and quarantines failures.
QUALITY_FAIL_ON_DUPLICATES=true
QUALITY_FAIL_ON_NULL_KEYS=true

# Table names (without catalog/schema prefixes)
BRONZE_ORDERS_TABLE=olist_orders_dataset
SILVER_ORDERS_TABLE=orders
QUARANTINE_ORDERS_TABLE=orders_quarantine

# Optional: live integration tests are skipped unless explicitly enabled.
RUN_DATABRICKS_INTEGRATION=false
